{
	"name": "susnux/secret_santa",
	"description": "Organize a secret gift exchange in Nextcloud",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "Ferdinand Thiessen",
			"email": "opensource@fthiessen.de"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\SecretSanta\\": "lib/"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"[ $COMPOSER_DEV_MODE -eq 0 ] || composer bin all install --ansi"
		],
		"post-update-cmd": [
			"[ $COMPOSER_DEV_MODE -eq 0 ] || composer bin all update --ansi"
		],
		"lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --no-cache",
		"test:unit": "phpunit -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
		"test:integration": "phpunit -c tests/integration/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
		"openapi": "generate-spec"
	},
	"require": {
		"ext-mbstring": "*"
	},
	"require-dev": {
		"bamarni/composer-bin-plugin": "^1.8"
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.3"
		}
	}
}
